# @plugin(../../dist/plugin.cjs)
# @generateSorbetEnv(path=env.rb)

# Deployment environment used by the application.
# @tag(api, app, hq, cli) @required @sensitive=false @type=enum(local, staging, demo, production)
PUBLIC_REAL_ENV=local

# @required @sensitive=false @type=boolean
ENABLED=false

# @required @sensitive=false @type=port
PORT=3000

# @required @sensitive=false @type=number
RATE=0.5

# @required @sensitive=false @type=string
APP_NAME=fixture-app

# @required=false @type=string
OPTIONAL=

# Integer coercion, including negative values
# @required @sensitive=false @type=number(isInt=true)
RETRY_COUNT=-2

# Untyped JSON object contents are preserved
# @required @sensitive=false @type=simple-object
METADATA='{"label":"fixture","nested":{"active":true},"items":[1,null]}'

# Boolean, numeric, and mixed enum serialized values retain their types
# @required @sensitive=false @type=enum(true, false)
BOOLEAN_CHOICE=false

# @required @sensitive=false @type=enum(-1, 2.5)
NUMERIC_CHOICE=2.5

# @required @sensitive=false @type=enum(auto, 2, false)
MIXED_CHOICE=2

# Optional enums cover both absent and populated values
# @required=false @sensitive=false @type=enum(local, production)
OPTIONAL_ENV=

# @required=false @sensitive=false @type=enum(local, production)
OPTIONAL_ENV_SET=production

# Arrays of primitive values and enums
# @required @sensitive=false @type=array(string)
LABELS='["api","worker"]'

# @required @sensitive=false @type=array(number(isInt=true))
COUNTS='[1,-2,3]'

# @required @sensitive=false @type=array(number)
RATIOS='[1,0.5]'

# @required @sensitive=false @type=array(boolean)
SWITCHES='[true,false]'

# @required @sensitive=false @type=array(enum(local, production))
DEPLOYMENTS='["local","production"]'

# @required @sensitive=false @type=array(simple-object)
SERVICES='[{"name":"api"},{"name":"worker"}]'

# @required @sensitive=false @type=array(string, minLength=0)
EMPTY_LABELS='[]'

# Records with typed values, enum values, and enum keys
# @required @sensitive=false @type=record(number(isInt=true))
LIMITS='{"api":10,"worker":2}'

# @required @sensitive=false @type=record(enum(enabled, disabled))
FEATURES='{"search":"enabled","export":"disabled"}'

# @required @sensitive=false @type=record(boolean, keyType=enum(us, eu))
REGIONS='{"us":true,"eu":false}'

# An enum-keyed record without a value schema uses T.untyped values
# @required @sensitive=false @type=record(keyType=enum(primary, secondary))
REGION_METADATA='{"primary":{"label":"api"},"secondary":[1,true]}'

# A plain record uses the same object representation as @type=simple-object
# @required @sensitive=false @type=record
EXTRA_METADATA='{"label":"extra","count":2}'

# Recursive collections: arrays of arrays, records of arrays, arrays of
# records, and records of records containing enums
# @required @sensitive=false @type=array(array(number(isInt=true)))
MATRIX='[[1,2],[3,4]]'

# @required @sensitive=false @type=record(array(enum(local, production)))
DEPLOYMENT_GROUPS='{"api":["local","production"],"worker":["production"]}'

# @required @sensitive=false @type=array(record(enum(enabled, disabled)))
FEATURE_SETS='[{"search":"enabled"},{"export":"disabled"}]'

# @required @sensitive=false @type=record(record(enum(low, high)))
PRIORITIES='{"api":{"read":"low","write":"high"}}'

# Optional collection values cover absence and populated nested values
# @required=false @sensitive=false @type=array(string)
OPTIONAL_LABELS=

# @required=false @sensitive=false @type=record(boolean)
OPTIONAL_FLAGS=

# @required=false @sensitive=false @type=record(array(enum(local, production)))
OPTIONAL_GROUPS='{"api":["production"]}'
